# Copie este arquivo para .env e preencha os valores reais. NUNCA suba o .env para o Git.
# Copy this file to .env and fill in the real values. NEVER commit .env to Git.

# Porta do servidor HTTP (dashboard + API da ponte)
# Padrão 3008: a porta 3007 já é da FC Bridge 0.5.8 — nunca suba os dois na mesma porta.
PORT=3008

# Caminho da sessão do WhatsApp (auth local, não apague esta pasta)
WHATSAPP_SESSION_PATH=./session

# Cliente WhatsApp próprio: false por padrão — enquanto o Muse é o atendente, este processo
# não abre outra sessão de WhatsApp (só HTTP + ponte). Mude para true quando este sistema assumir.
WHATSAPP_ENABLED=false

# Respostas automáticas no WhatsApp: false por padrão enquanto o Muse é o atendente principal.
# Só mude para true quando este sistema assumir o atendimento (evita responder junto com o Muse).
AUTO_REPLY_ENABLED=false

# Token opcional da ponte: se preenchido, /api/muse/order-result exige o header x-bridge-token
BRIDGE_TOKEN=

# Geração de imagens (QuackAPI) — sem a chave, a geração fica indisponível (erro claro, sem inventar rosto)
QUACK_API_KEY=
QUACK_API_URL=https://api.quack.example/v1/generate

# Chave PIX (Brasil) — só usada na mensagem de pagamento, após aprovação
PIX_KEY=

# Caminho do banco SQLite
DATABASE_PATH=./data/fc-pedidos.db

# Pasta monitorada a cada 8s para handoffs do Muse (imagens entregues pelo Muse)
MUSE_INBOX_DIR=./storage/muse-inbox

# Token de admin para confirmar pagamento e enviar prévia pela API/dashboard
ADMIN_TOKEN=troque-este-token-por-um-seguro

# Lease de executor único (segundos): por quanto tempo uma instância da extensão
# detém o envio de uma conversa antes do lease expirar (padrão 120)
LEASE_TTL_SECONDS=120

# FC Core v2.1.0 — intervalo do worker da fila persistente (ms; padrão 5000)
JOB_WORKER_INTERVAL_MS=5000

# FC Core v2.1.0 — alerta de disco: espaço livre (GB) abaixo disto aparece como
# "low" no /health (padrão 5)
DISK_WARN_FREE_GB=5

# FC Core v2.1.1 — TTL da reserva atômica de envio (segundos; padrão 600 = 10 min).
# A extensão reserva o envio antes de clicar no WhatsApp; a confirmação só vale
# dentro deste prazo e com o lease ainda válido.
RESERVATION_TTL_SECONDS=600

# FC Core v2.1.1 — TTL do heartbeat da extensão (segundos; padrão 120).
# Sem heartbeat dentro deste prazo, o /health mostra a extensão e a sessão do
# WhatsApp como 'stale'/'unknown' — nunca como autenticada indefinidamente.
HEARTBEAT_TTL_SECONDS=120
